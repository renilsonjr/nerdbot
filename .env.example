OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# Rate limits for public deployments. All are optional; the defaults shown
# here apply when a value is unset, invalid, or not a positive number.
RATE_LIMIT_COOLDOWN_SECONDS=3
RATE_LIMIT_SESSION_PER_HOUR=30
RATE_LIMIT_GLOBAL_PER_HOUR=250
RATE_LIMIT_GLOBAL_PER_DAY=1000
